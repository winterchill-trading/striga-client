; The live sandbox walk. [dune test] runs it, but it only talks to Striga when the
; credentials are set and STRIGA_LIVE_TESTS=1; otherwise it prints one line and exits 0,
; which is what CI (no credentials) sees. Each run creates two sandbox users.

(executable
 (name live)
 (libraries core async core_unix.command_unix striga-client yojson)
 (preprocess
  (pps ppx_jane)))

(rule
 (alias runtest)
 (action
  (run %{exe:live.exe})))
