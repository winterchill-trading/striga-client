# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Async client and CLI for the Striga crypto and banking API"
description:
  "HMAC-signed client for the Striga v1 API: users and KYC, wallets and accounts, enrichment, swaps, intraledger/interledger/SEPA/on-chain/Lightning payments with OTP confirmation, virtual cards, standing orders, strong customer authentication, sandbox simulator and webhook signature verification. Sandbox by default."
maintainer: ["winterchill-trading"]
authors: ["winterchill-trading"]
license: "MIT"
homepage: "https://github.com/winterchill-trading/striga-client"
bug-reports: "https://github.com/winterchill-trading/striga-client/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.17"}
  "core"
  "core_unix"
  "async"
  "async_ssl"
  "cohttp"
  "cohttp-async"
  "conduit-async"
  "uri"
  "yojson"
  "ppx_jane"
  "ppx_yojson_conv"
  "ppx_yojson_conv_lib"
  "cryptokit"
  "base64"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/winterchill-trading/striga-client.git"
